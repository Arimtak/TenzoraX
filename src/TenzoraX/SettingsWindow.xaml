<Window x:Class="TenzoraX.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TenzoraX"
        Title="{Binding Settings_Title}" Height="600" Width="520"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="{Binding Settings_Title}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>

        <!-- Scrollable settings -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- DESIGN: Flach / 3D / Shine – wirkt sofort auf alle Fenster. -->
                <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="8" BorderBrush="{DynamicResource BevelEdgeBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,10" Effect="{DynamicResource RaisedShadow}">
                    <StackPanel>
                        <TextBlock Text="{Binding Design_Section}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding Design_Label}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ComboTheme" Width="200" HorizontalAlignment="Left" Height="26"
                                  SelectionChanged="ComboTheme_Changed">
                            <ComboBoxItem Content="{Binding Design_Flat}" Tag="flat"/>
                            <ComboBoxItem Content="{Binding Design_3D}" Tag="3d"/>
                            <ComboBoxItem Content="{Binding Design_Shine}" Tag="shine"/>
                        </ComboBox>
                        <TextBlock Text="{Binding Design_Hint}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- APPEARANCE (animierter Hintergrund) -->
                <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="8" BorderBrush="{DynamicResource BevelEdgeBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,10" Effect="{DynamicResource RaisedShadow}">
                    <StackPanel>
                        <TextBlock Text="{Binding Background_Section}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkAnimatedBackground" Content="{Binding Background_EnableTitle}" Checked="ChkAnimatedBackground_Changed" Unchecked="ChkAnimatedBackground_Changed" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="{Binding Background_EnableHint}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="24,2,0,0"/>

                        <TextBlock Text="{Binding Background_QualityLabel}" FontSize="11" Foreground="White" Margin="24,10,0,4"/>
                        <!-- Kein Foreground="Black": Das Feld hat einen dunklen Hintergrund
                             (PanelBgBrush); schwarze Schrift wäre darauf unlesbar. -->
                        <ComboBox x:Name="ComboBackgroundQuality" Width="260" HorizontalAlignment="Left" Margin="24,0,0,0"
                                  SelectionChanged="ComboBackgroundQuality_Changed">
                            <ComboBoxItem Content="{Binding Background_QualityAuto}" Tag="0"/>
                            <ComboBoxItem Content="{Binding Background_QualityFull}" Tag="3"/>
                            <ComboBoxItem Content="{Binding Background_QualityReduced}" Tag="2"/>
                            <ComboBoxItem Content="{Binding Background_QualityMinimal}" Tag="1"/>
                        </ComboBox>
                        <TextBlock Text="{Binding Background_QualityHint}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="24,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- HOTKEY-NOTIFICATION -->
                <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="8" BorderBrush="{DynamicResource BevelEdgeBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,10" Effect="{DynamicResource RaisedShadow}">
                    <StackPanel>
                        <TextBlock Text="{Binding Notify_Section}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkNotification" Content="{Binding Notify_EnableTitle}" Checked="ChkNotification_Changed" Unchecked="ChkNotification_Changed" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="{Binding Notify_EnableHint}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="24,2,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Notify_Duration}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="SliderNotificationDuration" Grid.Column="1" Minimum="0.5" Maximum="10" Value="5.0" TickFrequency="0.5" TickPlacement="BottomRight" ValueChanged="SliderNotificationDuration_ValueChanged" Height="22" IsSnapToTickEnabled="True"/>
                        </Grid>
                        <TextBlock Text="{Binding Notify_DurationHint}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="24,2,0,12"/>

                        <TextBlock Text="{Binding Notify_CornerTitle}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button x:Name="BtnCornerTopLeft" Tag="TopLeft" Click="CornerButton_Click" Grid.Row="0" Grid.Column="0" Width="76" Height="46" Margin="0,0,6,6" Padding="0" ToolTip="{Binding Notify_CornerTopLeft}">
                                <Border Width="52" Height="28" CornerRadius="3" BorderBrush="#475569" BorderThickness="1">
                                    <Ellipse x:Name="DotTopLeft" Width="7" Height="7" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3" Visibility="Collapsed"/>
                                </Border>
                            </Button>
                            <Button x:Name="BtnCornerTopRight" Tag="TopRight" Click="CornerButton_Click" Grid.Row="0" Grid.Column="1" Width="76" Height="46" Margin="0,0,0,6" Padding="0" ToolTip="{Binding Notify_CornerTopRight}">
                                <Border Width="52" Height="28" CornerRadius="3" BorderBrush="#475569" BorderThickness="1">
                                    <Ellipse x:Name="DotTopRight" Width="7" Height="7" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3" Visibility="Collapsed"/>
                                </Border>
                            </Button>
                            <Button x:Name="BtnCornerBottomLeft" Tag="BottomLeft" Click="CornerButton_Click" Grid.Row="1" Grid.Column="0" Width="76" Height="46" Margin="0,0,6,0" Padding="0" ToolTip="{Binding Notify_CornerBottomLeft}">
                                <Border Width="52" Height="28" CornerRadius="3" BorderBrush="#475569" BorderThickness="1">
                                    <Ellipse x:Name="DotBottomLeft" Width="7" Height="7" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3" Visibility="Collapsed"/>
                                </Border>
                            </Button>
                            <Button x:Name="BtnCornerBottomRight" Tag="BottomRight" Click="CornerButton_Click" Grid.Row="1" Grid.Column="1" Width="76" Height="46" Margin="0" Padding="0" ToolTip="{Binding Notify_CornerBottomRight}">
                                <Border Width="52" Height="28" CornerRadius="3" BorderBrush="#475569" BorderThickness="1">
                                    <Ellipse x:Name="DotBottomRight" Width="7" Height="7" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3" Visibility="Collapsed"/>
                                </Border>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SOUNDFEEDBACK -->
                <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="8" BorderBrush="{DynamicResource BevelEdgeBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,10" Effect="{DynamicResource RaisedShadow}">
                    <StackPanel>
                        <TextBlock Text="{Binding Sound_Section}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkSound" Content="{Binding Sound_EnableTitle}" Checked="ChkSound_Changed" Unchecked="ChkSound_Changed" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="{Binding Sound_EnableHint}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="24,2,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Sound_VolumeLabel}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="SliderSoundVolume" Grid.Column="1" Minimum="0" Maximum="100" Value="50" TickFrequency="10" TickPlacement="None" ValueChanged="SliderSoundVolume_ValueChanged" Height="22"/>
                        </Grid>
                        <TextBlock Text="{Binding Sound_VolumeHint}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="24,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ALLGEMEIN -->
                <Border Background="{DynamicResource SurfaceCardBrush}" CornerRadius="8" BorderBrush="{DynamicResource BevelEdgeBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,10" Effect="{DynamicResource RaisedShadow}">
                    <StackPanel>
                        <TextBlock Text="{Binding Settings_GeneralSection}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Settings_LanguageLabel}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ComboLanguage" Grid.Column="1" SelectionChanged="ComboLanguage_Changed" Height="26" Width="140" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Deutsch" Tag="de"/>
                                <ComboBoxItem Content="English" Tag="en"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Settings_ReselectLabel}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ComboReselectMode" Grid.Column="1" SelectionChanged="ComboReselectMode_Changed" Height="26" Width="220" HorizontalAlignment="Left">
                                <ComboBoxItem Content="{Binding Reselect_First}" Tag="first"/>
                                <ComboBoxItem Content="{Binding Reselect_Last}" Tag="last"/>
                            </ComboBox>
                        </Grid>

                        <CheckBox x:Name="ChkAutostart" Content="{Binding Edit_Autostart}" Checked="ChkAutostart_Changed" Unchecked="ChkAutostart_Changed" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="{Binding Settings_AutostartHint}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="24,2,0,10"/>

                        <CheckBox x:Name="ChkStartMinimized" Content="{Binding Edit_StartMinimized}" Checked="ChkStartMinimized_Changed" Unchecked="ChkStartMinimized_Changed" Foreground="White"/>
                        <TextBlock Text="{Binding Settings_StartMinimizedHint}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="24,2,0,10"/>

                        <CheckBox x:Name="ChkMinimizeToTray" Content="{Binding Edit_MinimizeToTray}" Checked="ChkMinimizeToTray_Changed" Unchecked="ChkMinimizeToTray_Changed" Foreground="White"/>
                        <TextBlock Text="{Binding Settings_MinimizeToTrayHint}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="24,2,0,10"/>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,6,0,10"/>

                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="ChkAdminMode" Content="{Binding Edit_AdminMode}" Checked="ChkAdminMode_Changed" Unchecked="ChkAdminMode_Changed" Foreground="White"/>
                            <TextBlock x:Name="TxtAdminStatus" Text="" Grid.Column="1" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding Settings_AdminHint}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="24,2,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom: Version + Update -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceCardBrush}" CornerRadius="8" BorderBrush="{DynamicResource BevelEdgeBrush}" BorderThickness="1" Padding="14" Margin="0,12,0,0" Effect="{DynamicResource RaisedShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TenzoraX" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TxtSettingsVersion" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnCheckUpdate" Content="{Binding Settings_UpdateCheck}" Click="BtnCheckUpdate_Click" Height="30" Padding="12,0" FontSize="10" Foreground="{StaticResource AccentBrush}" Background="{DynamicResource SurfaceAccentBrush}" BorderBrush="{DynamicResource BevelActiveBrush}" BorderThickness="1" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="{Binding Settings_Close}" Click="BtnClose_Click" Height="30" Padding="12,0" FontSize="10" Foreground="White" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BevelEdgeBrush}" BorderThickness="1"/>
            </Grid>
        </Border>

    </Grid>
</Window>

