<Window x:Class="TenzoraX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TenzoraX"
        xmlns:effects="clr-namespace:TenzoraX.Effects"
        mc:Ignorable="d"
         Title="TenzoraX" Height="720" Width="1180" MinWidth="900" MinHeight="600"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">

    <Window.Resources>
        <!-- Style for circular controller buttons -->
        <Style x:Key="CircularBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#00FFFFFF"/>
            <Setter Property="Opacity" Value="1.0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="Transparent" CornerRadius="13" TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tastatur-Taste: gewoelbte Fläche + Lichtkante oben links, Schattenkante
             unten rechts. Bewusst OHNE DropShadowEffect – bei ~90 Tasten pro Fenster
             waere das viele zusätzliche Rechenarbeit; die Kante erzeugt die Tiefe. -->
        <Style x:Key="KeyBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BevelEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="{DynamicResource SurfaceRaisedHoverBrush}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource BevelHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="border" Value="{DynamicResource SurfaceSunkenBrush}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource BevelActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpecialKeyStyle" TargetType="Button" BasedOn="{StaticResource KeyBtnStyle}">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BevelActiveBrush}"/>
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>

        <!-- Keycap Templates for Mapping Parts -->
        <DataTemplate x:Key="KeycapButtonTemplate">
            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BevelActiveBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="1,0" Effect="{DynamicResource RaisedShadow}">
                <TextBlock Text="{Binding Text}" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="KeycapSeparatorTemplate">
            <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="3,0"/>
        </DataTemplate>

        <local:MappingPartTemplateSelector x:Key="MappingPartSelector"
            ButtonTemplate="{StaticResource KeycapButtonTemplate}"
            SeparatorTemplate="{StaticResource KeycapSeparatorTemplate}"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Dark TabControl / TabItem Styles -->
        <Style x:Key="DarkTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Background="Transparent" Margin="0,0,0,6"/>
                            <Border Grid.Row="1" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BevelEdgeBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border CornerRadius="6" Margin="0,0,4,0" Background="{TemplateBinding Background}" Effect="{DynamicResource RaisedShadow}"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{DynamicResource BevelEdgeBrush}" BorderThickness="1" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" TargetName="Bd" Value="{DynamicResource SurfaceSelectedBrush}"/>
                                <Setter Property="BorderBrush" TargetName="Bd" Value="{DynamicResource BevelActiveBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Wurzel: animierter Hintergrund (GhostFibers, Pixel-Shader) hinter dem gesamten Inhalt.
         Der Shader erzeugt die Fläche vollständig selbst; die Hintergrundfarbe ist nur der
         Rückfall, wenn der Effekt abgeschaltet ist oder der Shader nicht geladen werden kann.
         Die Spartan-Stufen verringern die Rechenarbeit im Shader (Faserschichten, Grain) – eine
         Auflösungsreduktion ließ sich in WPF nicht zuverlässig erreichen. -->
    <Grid x:Name="RootGrid">
        <Border x:Name="GhostFibersBackground" Background="#12101A" ClipToBounds="True">
            <Border.Effect>
                <effects:GhostFibersEffect x:Name="BackgroundEffect"/>
            </Border.Effect>
        </Border>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- HEADER BAR -->
        <ContentControl Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Panel3DStyle}" Padding="14,6" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="TenzoraX" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <!-- Klickbares Controller-Icon: öffnet das Windows-Fenster "Game Controller"
                     (joy.cpl) mit allen installierten Controllern – dort lassen sich die
                     Controller testen und konfigurieren. -->
                <Button x:Name="BtnControllerHistoryHeader" Grid.Column="1" Click="BtnOpenGameControllersMain_Click" Width="28" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="{Binding Vigem_OpenControllers}">
                    <Image Source="pack://application:,,,/assets/icons/video-game-gamepad-icon_ico_32x32.ico" Width="18" Height="18" Stretch="Uniform"/>
                </Button>
                <!-- Treiber-Status-Licht: grün = ViGEmBus + HidHide installiert, rot = fehlen.
                     Klick: fehlende Treiber herunterladen und installieren. -->
                <Button x:Name="BtnDriversHeader" Grid.Column="2" Click="BtnDriversHeader_Click" Width="28" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="{Binding Drivers_HeaderTooltip}">
                    <Ellipse x:Name="DriversStatusDotHeader" Width="16" Height="16" Fill="#64748B" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"/>
                </Button>
                <Button x:Name="BtnSettings" Grid.Column="3" Content="⚙" Click="BtnSettings_Click" Width="28" Height="24" Padding="0" FontSize="14" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedTextBrush}" Cursor="Hand"/>
            </Grid>
        </ContentControl>

        <!-- LEFT PANEL: Gamepad & Keyboard -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                    <RowDefinition x:Name="GamepadRow" Height="370"/>
                    <RowDefinition x:Name="SplitterRow" Height="8"/>
                    <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- SECTION 1: Virtual Gamepad -->
            <ContentControl Grid.Row="0" Style="{StaticResource Panel3DStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Gamepad Header Info -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="🎮" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ComboGamepads" Width="240" SelectionChanged="ComboGamepads_SelectionChanged" PreviewKeyDown="ComboGamepads_PreviewKeyDown" VerticalAlignment="Center" Height="26"/>
                            <Button x:Name="BtnControllerHistory" Content="🕘" Width="26" Height="26" Margin="6,0,0,0" Padding="0" FontSize="11" ToolTip="{Binding History_Button}" Click="BtnControllerHistory_Click"/>
                            <Button x:Name="BtnDiagnostics" Content="🔍" Width="26" Height="26" Margin="6,0,0,0" Padding="0" FontSize="11" ToolTip="{Binding Diag_Button}" Click="BtnDiagnostics_Click"/>
                        </StackPanel>
                        <!-- Controller-Feld ein-/ausklappen: ausgeklappt bleibt nur diese
                             Kopfzeile stehen, die Tastatur bekommt den frei gewordenen Platz. -->
                        <Button x:Name="BtnToggleGamepad" Grid.Column="2" Content="▾" Width="26" Height="26"
                                Padding="0" FontSize="11" VerticalAlignment="Center"
                                ToolTip="{Binding Gamepad_Collapse}" Click="BtnToggleGamepad_Click"/>

                        <!-- Hinweis: Die App listet ein Pad, Windows führt aber weder XInput
                             noch DirectInput ein Gerät (typisch: Schnittstelle deaktiviert).
                             Bleibt zusammengeklappt, solange alles zusammenpasst. -->
                        <Border x:Name="BannerInputMismatch" Grid.Row="1" Grid.ColumnSpan="3"
                                Visibility="Collapsed" Background="#2A1E08" BorderBrush="#B45309"
                                BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock x:Name="TxtInputMismatch" FontSize="9" Foreground="#FBBF24"
                                           TextWrapping="Wrap"/>
                                <!-- Ein Klick löst die einmalige UAC-Abfrage aus und schaltet genau
                                     diese Schnittstelle wieder ein. -->
                                <Button x:Name="BtnEnableDisabledInterface" Content="Schnittstelle aktivieren"
                                        Visibility="Collapsed" Click="BtnEnableDisabledInterface_Click"
                                        HorizontalAlignment="Left" Margin="0,5,0,0" Padding="8,2"
                                        FontSize="9" Foreground="#FBBF24" Background="#3A2A0F"
                                        BorderBrush="#B45309" BorderThickness="1" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Gamepad Visual Interface with Background Image -->
                    <Border x:Name="GamepadSurface" Grid.Row="2" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="8" BorderBrush="{DynamicResource BevelInsetBrush}" BorderThickness="1">
                        <Canvas x:Name="CanvasGamepad" ClipToBounds="True" Background="Transparent" MouseDown="CanvasGamepad_MouseDown" KeyDown="CanvasGamepad_KeyDown" Focusable="True">
                            <!-- Controller Background Image -->
                            <Image x:Name="ImgController" Source="pack://application:,,,/assets/icons/xbox-360.png" Stretch="Uniform"/>
                            
                            <!-- Die Koordinaten hier sind die Ausgangslage (Bild bei 50,20 in 400x277);
                                 beim Laden setzt die App die in Bildanteilen gespeicherten Vorgabewerte
                                 (siehe MainWindow.DefaultRelativePositions). L1/L2 und R1/R2 liegen
                                 bewusst außerhalb des Bildes, oberhalb des Pads. -->

                            <!-- L2 & R2 (Triggers - oben) - gleiche Größe wie L1/R1 -->
                            <Button x:Name="Btn_L2" Content="L2" Style="{StaticResource CircularBtnStyle}" Width="65" Height="24" Canvas.Left="118" Canvas.Top="0" Click="GamepadButton_Click" FontSize="10"/>
                            <Button x:Name="Btn_R2" Content="R2" Style="{StaticResource CircularBtnStyle}" Width="65" Height="24" Canvas.Left="320" Canvas.Top="0" Click="GamepadButton_Click" FontSize="10"/>

                            <!-- L1 & R1 (Bumpers) -->
                            <Button x:Name="Btn_L1" Content="L1" Style="{StaticResource CircularBtnStyle}" Width="65" Height="24" Canvas.Left="118" Canvas.Top="25" Click="GamepadButton_Click"/>
                            <Button x:Name="Btn_R1" Content="R1" Style="{StaticResource CircularBtnStyle}" Width="65" Height="24" Canvas.Left="320" Canvas.Top="25" Click="GamepadButton_Click"/>

                            <!-- D-Pad (links): die vier Pfeile bilden EIN kompaktes Kreuz auf dem
                                 hellgrauen Plus der Vorlage und liegen ohne eigene Kachelfläche im
                                 Kreis (Fläche macht UpdateButtonsAppearance nicht mehr). Lage
                                 gemessen: Plus-Mitte (0,3512|0,5234) im Bild, Armradius 14 DIP. -->
                            <Button x:Name="Btn_DPAD_UP" Content="▲" Style="{StaticResource CircularBtnStyle}" Width="24" Height="24" Canvas.Left="128" Canvas.Top="119" Click="GamepadButton_Click" FontSize="12"/>
                            <Button x:Name="Btn_DPAD_DOWN" Content="▼" Style="{StaticResource CircularBtnStyle}" Width="24" Height="24" Canvas.Left="128" Canvas.Top="147" Click="GamepadButton_Click" FontSize="12"/>
                            <Button x:Name="Btn_DPAD_LEFT" Content="◀" Style="{StaticResource CircularBtnStyle}" Width="24" Height="24" Canvas.Left="114" Canvas.Top="133" Click="GamepadButton_Click" FontSize="12"/>
                            <Button x:Name="Btn_DPAD_RIGHT" Content="▶" Style="{StaticResource CircularBtnStyle}" Width="24" Height="24" Canvas.Left="142" Canvas.Top="133" Click="GamepadButton_Click" FontSize="12"/>

                            <!-- Mitte wie am echten Pad: HOME sitzt genau auf dem Xbox-Logo,
                                 SELECT und START flankieren es als Back/Menu. -->
                            <Button x:Name="Btn_HOME" Content="HOME" Style="{StaticResource CircularBtnStyle}" Width="50" Height="20" Canvas.Left="226" Canvas.Top="86" Click="GamepadButton_Click" FontSize="9"/>
                            <Button x:Name="Btn_SELECT" Content="SELECT" Style="{StaticResource CircularBtnStyle}" Width="50" Height="20" Canvas.Left="178" Canvas.Top="86" Click="GamepadButton_Click" FontSize="9"/>
                            <Button x:Name="Btn_START" Content="START" Style="{StaticResource CircularBtnStyle}" Width="50" Height="20" Canvas.Left="274" Canvas.Top="86" Click="GamepadButton_Click" FontSize="9"/>

                            <!-- Left Analog Stick (L3) with visual ring - Xbox 360 position -->
                            <Canvas x:Name="Canvas_L3" Width="50" Height="50" Canvas.Left="112" Canvas.Top="67">
                                <Ellipse x:Name="Ring_L3" Width="50" Height="50" Stroke="#45455D" StrokeThickness="2" Fill="#14141B"/>
                                <Button x:Name="Btn_L3" Content="L3" Style="{StaticResource CircularBtnStyle}" Width="26" Height="26" Canvas.Left="12" Canvas.Top="12" Click="GamepadButton_Click" FontSize="9"/>
                            </Canvas>

                            <!-- Right Analog Stick (R3) with visual ring - Xbox 360 position -->
                            <Canvas x:Name="Canvas_R3" Width="50" Height="50" Canvas.Left="287" Canvas.Top="139">
                                <Ellipse x:Name="Ring_R3" Width="50" Height="50" Stroke="#45455D" StrokeThickness="2" Fill="#14141B"/>
                                <Button x:Name="Btn_R3" Content="R3" Style="{StaticResource CircularBtnStyle}" Width="26" Height="26" Canvas.Left="12" Canvas.Top="12" Click="GamepadButton_Click" FontSize="9"/>
                            </Canvas>

                            <!-- Action Buttons (A, B, X, Y) - rund, als Raute um die Bildmitte der Tasten -->
                            <Button x:Name="Btn_Y" Content="Y" Style="{StaticResource CircularBtnStyle}" Width="24" Height="24" Canvas.Left="357" Canvas.Top="51" Click="GamepadButton_Click" FontSize="12"/>
                            <Button x:Name="Btn_X" Content="X" Style="{StaticResource CircularBtnStyle}" Width="24" Height="24" Canvas.Left="326" Canvas.Top="83" Click="GamepadButton_Click" FontSize="12"/>
                            <Button x:Name="Btn_B" Content="B" Style="{StaticResource CircularBtnStyle}" Width="24" Height="24" Canvas.Left="389" Canvas.Top="83" Click="GamepadButton_Click" FontSize="12"/>
                            <Button x:Name="Btn_A" Content="A" Style="{StaticResource CircularBtnStyle}" Width="24" Height="24" Canvas.Left="357" Canvas.Top="115" Click="GamepadButton_Click" FontSize="12"/>
                        </Canvas>
                    </Border>
                </Grid>
            </ContentControl>

            <GridSplitter x:Name="SplitterGamepad" Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- SECTION 2: Virtual Keyboard -->
            <ContentControl Grid.Row="2" Style="{StaticResource Panel3DStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding KB_Heading}" FontWeight="Bold" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource MutedTextBrush}"/>

                    <!-- Die Tastatur füllt den verfügbaren Platz: jede Tastenreihe ist eine
                         Sternzeile, damit die Tasten mit dem Fenster wachsen. Ist das
                         Controller-Feld eingeklappt, bekommt sie den ganzen linken Bereich.
                         MaxHeight verhindert übergroße Tasten auf sehr hohen Fenstern. -->
                    <ScrollViewer x:Name="KeyboardScroll" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <!-- Mindesthöhe: 284 DIP ergeben gemessen ~22 DIP Tastenhöhe (Buchstaben)
                             bzw. ~20 DIP (NumPad) – darunter würden die Beschriftungen beschnitten.
                             Reicht der Platz nicht (z. B. 900x600 mit sichtbarem Controller-Feld),
                             hält die Tastatur diese Größe und wird scrollbar, statt zu verschwinden.
                             Height = ViewportHeight, damit sie bei genügend Platz die Fläche füllt. -->
                        <Grid x:Name="KeyboardPanel" MinHeight="284"
                              Height="{Binding ViewportHeight, ElementName=KeyboardScroll}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1*" MaxHeight="64"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1*" MaxHeight="64"/>
                                <RowDefinition Height="4.8*" MaxHeight="289"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding KB_FnKeys}" Style="{StaticResource SectionLabelStyle}" Margin="0,2,0,1"/>
                            <UniformGrid Grid.Row="1" Columns="13" Rows="1" Margin="0,0,0,3">
                                <Button Content="ESC" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                <Button Content="F1" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                <Button Content="F2" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                <Button Content="F3" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                <Button Content="F4" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                <Button Content="F5" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                <Button Content="F6" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                <Button Content="F7" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                <Button Content="F8" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                <Button Content="F9" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                <Button Content="F10" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                <Button Content="F11" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                <Button Content="F12" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                            </UniformGrid>

                            <Border Grid.Row="2" Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BevelInsetBrush}" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="0,1,0,2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding KB_GamingShortcuts}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10" Margin="0,0,0,2"/>
                                    <UniformGrid Grid.Row="1" Columns="12" Rows="1" Height="24">
                                        <Button Content="F13" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                        <Button Content="F14" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                        <Button Content="F15" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                        <Button Content="F16" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                        <Button Content="F17" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                        <Button Content="F18" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                        <Button Content="F19" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                        <Button Content="F20" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                        <Button Content="F21" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                        <Button Content="F22" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                        <Button Content="F23" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                        <Button Content="F24" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                    </UniformGrid>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="3" Text="{Binding KB_NumberRow}" Style="{StaticResource SectionLabelStyle}" Margin="0,2,0,1"/>
                            <UniformGrid Grid.Row="4" Columns="11" Rows="1" Margin="0,0,0,3">
                                <Button Content="TAB" Style="{StaticResource KeyBtnStyle}" FontWeight="Bold" Click="KeyboardKey_Click" FontSize="10"/>
                                <Button Content="1" Style="{StaticResource KeyBtnStyle}" FontWeight="Bold" FontSize="12" Click="KeyboardKey_Click"/>
                                <Button Content="2" Style="{StaticResource KeyBtnStyle}" FontWeight="Bold" FontSize="12" Click="KeyboardKey_Click"/>
                                <Button Content="3" Style="{StaticResource KeyBtnStyle}" FontWeight="Bold" FontSize="12" Click="KeyboardKey_Click"/>
                                <Button Content="4" Style="{StaticResource KeyBtnStyle}" FontWeight="Bold" FontSize="12" Click="KeyboardKey_Click"/>
                                <Button Content="5" Style="{StaticResource KeyBtnStyle}" FontWeight="Bold" FontSize="12" Click="KeyboardKey_Click"/>
                                <Button Content="6" Style="{StaticResource KeyBtnStyle}" FontWeight="Bold" FontSize="12" Click="KeyboardKey_Click"/>
                                <Button Content="7" Style="{StaticResource KeyBtnStyle}" FontWeight="Bold" FontSize="12" Click="KeyboardKey_Click"/>
                                <Button Content="8" Style="{StaticResource KeyBtnStyle}" FontWeight="Bold" FontSize="12" Click="KeyboardKey_Click"/>
                                <Button Content="9" Style="{StaticResource KeyBtnStyle}" FontWeight="Bold" FontSize="12" Click="KeyboardKey_Click"/>
                                <Button Content="0" Style="{StaticResource KeyBtnStyle}" FontWeight="Bold" FontSize="12" Click="KeyboardKey_Click"/>
                            </UniformGrid>

                            <!-- Buchstaben und Ziffernblock nebeneinander: untereinander bräuchte
                                 der NumPad-Block eine eigene Zeile und die Tastatur müsste dafür
                                 schrumpfen. -->
                            <Grid Grid.Row="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10*"/>
                                    <ColumnDefinition Width="4.6*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,6,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="1*"/>
                                        <RowDefinition Height="1*"/>
                                        <RowDefinition Height="1*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="1*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding KB_Letters}" Style="{StaticResource SectionLabelStyle}" Margin="0,2,0,1"/>
                                    <UniformGrid Grid.Row="1" Columns="10" Rows="1" Margin="0,0,0,1">
                                        <Button Content="Q" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="W" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="E" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="R" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="T" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="Y" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="U" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="I" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="O" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="P" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                    </UniformGrid>

                                    <UniformGrid Grid.Row="2" Columns="10" Rows="1" Margin="0,0,0,1">
                                        <Button Content="A" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="S" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="D" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="F" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="G" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="H" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="J" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="K" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="L" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="ENTER" Style="{StaticResource KeyBtnStyle}" FontWeight="Bold" Click="KeyboardKey_Click" FontSize="10"/>
                                    </UniformGrid>

                                    <UniformGrid Grid.Row="3" Columns="10" Rows="1" Margin="0,0,0,1">
                                        <Button Content="SHIFT" Style="{StaticResource KeyBtnStyle}" FontWeight="Bold" Click="KeyboardKey_Click" FontSize="10"/>
                                        <Button Content="Z" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="X" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="C" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="V" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="B" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="N" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="M" Style="{StaticResource KeyBtnStyle}" FontSize="11" Click="KeyboardKey_Click"/>
                                        <Button Content="SPACE" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                        <Button Content="WIN" Style="{StaticResource KeyBtnStyle}" FontWeight="Bold" Click="KeyboardKey_Click" FontSize="10"/>
                                    </UniformGrid>

                                    <TextBlock Grid.Row="4" Text="{Binding KB_Modifiers}" Style="{StaticResource SectionLabelStyle}" Margin="0,2,0,1"/>
                                    <UniformGrid Grid.Row="5" Columns="6" Rows="1" Margin="0,0,0,1">
                                        <Button Content="CTRL" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                        <Button Content="ALT" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                        <Button Content="SPACE" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                        <Button Content="{Binding Btn_MouseL}" Tag="MOUSE_LEFT" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="9"/>
                                        <Button Content="{Binding Btn_MouseR}" Tag="MOUSE_RIGHT" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="9"/>
                                        <Button Content="{Binding Btn_MouseM}" Tag="MOUSE_MIDDLE" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="9"/>
                                    </UniformGrid>
                                </Grid>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="1*"/>
                                        <RowDefinition Height="1*"/>
                                        <RowDefinition Height="1*"/>
                                        <RowDefinition Height="1*"/>
                                        <RowDefinition Height="1*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding KB_NumPad}" Style="{StaticResource SectionLabelStyle}" Margin="0,2,0,1"/>
                                    <Border Grid.Row="1" Grid.RowSpan="5" Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BevelInsetBrush}" BorderThickness="1" CornerRadius="5" Padding="4,2" Margin="0,1,0,1">
                                        <UniformGrid Columns="4" Rows="5">
                                            <Button Content="NumLock" Tag="NUMLOCK" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="8"/>
                                            <Button Content="/" Tag="NUMPAD_DIV" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                            <Button Content="*" Tag="NUMPAD_MUL" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                            <Button Content="-" Tag="NUMPAD_MINUS" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="10"/>
                                            <Button Content="7" Tag="NUMPAD_7" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="9"/>
                                            <Button Content="8" Tag="NUMPAD_8" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="9"/>
                                            <Button Content="9" Tag="NUMPAD_9" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="9"/>
                                            <Button Content="+" Tag="NUMPAD_PLUS" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="9"/>
                                            <Button Content="4" Tag="NUMPAD_4" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="9"/>
                                            <Button Content="5" Tag="NUMPAD_5" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="9"/>
                                            <Button Content="6" Tag="NUMPAD_6" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="9"/>
                                            <Border/>
                                            <Button Content="1" Tag="NUMPAD_1" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="9"/>
                                            <Button Content="2" Tag="NUMPAD_2" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="9"/>
                                            <Button Content="3" Tag="NUMPAD_3" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="9"/>
                                            <Button Content="." Tag="NUMPAD_DOT" Style="{StaticResource SpecialKeyStyle}" Click="KeyboardKey_Click" FontSize="9"/>
                                            <Button Content="0" Tag="NUMPAD_0" Style="{StaticResource KeyBtnStyle}" Click="KeyboardKey_Click" FontSize="9"/>
                                            <Border/>
                                            <Border/>
                                            <Border/>
                                        </UniformGrid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </ContentControl>
        </Grid>

        <!-- RIGHT PANEL: Profiles -->
        <ContentControl Grid.Row="1" Grid.Column="1" Style="{StaticResource Panel3DStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Profile_Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ComboProfiles" SelectionChanged="ComboProfiles_SelectionChanged" Grid.Column="0" Height="28"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                            <Button Content="{Binding Profile_New}" Click="BtnNewProfile_Click" Height="28" Width="42" Margin="0,0,4,0"/>
                            <Button Content="{Binding Profile_Delete}" Click="BtnDeleteProfile_Click" Height="28" Width="46" Foreground="#EF4444"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <ContentControl Grid.Row="1" Style="{StaticResource Card3DStyle}" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Mapping_Title}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="BtnRecord" Content="{Binding Mapping_Record}" Click="BtnRecord_Click" Height="24" Padding="8,0" Margin="0,0,0,0" FontSize="10" FontWeight="Bold" Foreground="#10B981" Background="#0F2C3A" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"/>
                        </Grid>
                        
                        <TextBlock Text="{Binding Mapping_ControllerLabel}" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                        <Grid Margin="0,4,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BevelInsetBrush}" BorderThickness="1" CornerRadius="5" Padding="6,4">
                                <TextBlock x:Name="TxtSelectedCombo" Text="{Binding Mapping_ComboPlaceholder}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="11"/>
                            </Border>
                            <Button Content="✕" Click="BtnClearCombo_Click" Grid.Column="1" Margin="6,0,0,0" Height="24" Width="24" Padding="0" FontSize="10"/>
                        </Grid>

                        <TextBlock Text="{Binding Mapping_ActionLabel}" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BevelInsetBrush}" BorderThickness="1" CornerRadius="5" Padding="6,4">
                                <TextBlock x:Name="TxtSelectedAction" Text="{Binding Mapping_ActionPlaceholder}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="11"/>
                            </Border>
                            <Button Content="✕" Click="BtnClearAction_Click" Grid.Column="1" Margin="6,0,0,0" Height="24" Width="24" Padding="0" FontSize="10"/>
                        </Grid>

                        <TextBlock Text="{Binding Mapping_NameLabel}" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                        <Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BevelInsetBrush}" BorderThickness="1" CornerRadius="5" Padding="6,4" Margin="0,4,0,8">
                            <TextBox x:Name="TxtMappingName" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="White" VerticalContentAlignment="Center" ToolTip="{Binding Mapping_NameHint}"/>
                        </Border>

                        <CheckBox x:Name="ChkMappingToggle" Content="{Binding Mapping_ToggleLabel}" ToolTip="{Binding Mapping_ToggleHint}" FontSize="10" Foreground="White" Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="{Binding Mapping_Save}" Click="BtnSaveMapping_Click" FontWeight="Bold" Height="30" Background="{DynamicResource SurfaceAccentBrush}" BorderBrush="{DynamicResource BevelActiveBrush}" FontSize="11"/>
                            <Button Grid.Column="1" Content="{Binding Btn_TestOutput}" Click="BtnTestOutput_Click" Height="30" Padding="8,0" Margin="6,0,0,0" FontSize="10" Foreground="#F59E0B" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BevelEdgeBrush}" BorderThickness="1"/>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding OutputMode_Label}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="ComboOutputMode" Grid.Column="1" SelectionChanged="ComboOutputMode_SelectionChanged" Height="24" FontSize="10"/>
                        </Grid>
                    </StackPanel>
                </ContentControl>

                <!-- Gespeicherte Kombinationen: Reiterleiste und der Reiter „Xbox 360 & HidHide"
                     sind entfernt, damit die Liste den ganzen Bereich bekommt. Kein sichtbarer
                     Regler: VerticalScrollBarVisibility="Hidden" rollt weiter mit dem Mausrad,
                     zeigt aber keinen Balken; HorizontalContentAlignment streckt jede Karte auf
                     dieselbe Breite (vorher unterschiedlich breit und rechts abgeschnitten). -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding Mapping_ListTitle}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BevelEdgeBrush}" BorderThickness="1" CornerRadius="6">
                            <ListBox x:Name="ListMappings" Background="Transparent" BorderThickness="0" Margin="4"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                     SelectionChanged="ListMappings_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceListCardBrush}" BorderBrush="{DynamicResource BevelEdgeBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,3">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ItemsControl ItemsSource="{Binding ComboParts}" ItemTemplateSelector="{StaticResource MappingPartSelector}" Grid.Column="0" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                                <TextBlock Text="➔" Foreground="{StaticResource AccentBrush}" Margin="6,0" Grid.Column="1" VerticalAlignment="Center" FontSize="15"/>
                                                <ItemsControl ItemsSource="{Binding ActionParts}" ItemTemplateSelector="{StaticResource MappingPartSelector}" Grid.Column="2" VerticalAlignment="Center" Visibility="{Binding HasActionOutput, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                                <Button Content="✕" Click="BtnDeleteMapping_Click" Tag="{Binding}" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Grid.Column="4" Padding="4,2" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                                <Border Grid.Column="3" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding Toggle, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding DataContext.Mapping_ToggleBadge, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding ActionName}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" Foreground="White" Margin="0,5,0,0" Visibility="{Binding HasName, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            </ListBox>
                    </Border>
                </Grid>

                <!-- Xbox-360-Spiegelung und HidHide: auf Wunsch aus der Oberfläche entfernt.
                     Die Bedienelemente bleiben bewusst verborgen im Fensterbaum, damit die
                     Statuspflege und die Automatik im Code unverändert weiterlaufen (kein
                     stiller Funktionsverlust); der Treiber-Zustand bleibt über das Licht in
                     der Kopfzeile und den Game-Controller-Knopf erreichbar. -->
                <StackPanel x:Name="PanelVigemHidhide" Grid.Row="2" Visibility="Collapsed">
                    <TextBlock Text="{Binding Vigem_Section}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>

                    <CheckBox x:Name="ChkVigemXboxMain" Content="{Binding Vigem_EnableTitle}" Checked="ChkVigemXboxMain_Changed" Unchecked="ChkVigemXboxMain_Changed" FontWeight="SemiBold" Foreground="White" FontSize="10" Margin="0,0,0,4"/>
                    <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="5" BorderBrush="{DynamicResource BevelInsetBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="VigemStatusDotMain" Width="9" Height="9" Fill="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtVigemStatusMain" Text="" FontSize="10" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>


                    <Button x:Name="BtnCheckDrivers" Content="{Binding Drivers_CheckButton}" Click="BtnCheckDrivers_Click" Height="26" Padding="10,1" FontSize="9" Foreground="{StaticResource AccentBrush}" Background="#0F2C3A" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Margin="0,0,0,4" HorizontalAlignment="Left"/>
                    <Button x:Name="BtnInstallHidhideMain" Content="{Binding Hidhide_Install}" Click="BtnInstallHidhideMain_Click" Height="26" Padding="10,1" FontSize="9" Foreground="{StaticResource AccentBrush}" Background="#0F2C3A" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Margin="0,0,0,4" HorizontalAlignment="Left"/>
                    <Button x:Name="BtnOpenGameControllersMain" Content="{Binding Vigem_OpenControllers}" Click="BtnOpenGameControllersMain_Click" Height="26" Padding="10,1" FontSize="9" Foreground="{StaticResource AccentBrush}" Background="#0F2C3A" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Margin="0,0,0,8" HorizontalAlignment="Left"/>

                    <TextBlock Text="{Binding Hidhide_Title}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="5" BorderBrush="{DynamicResource BevelInsetBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="HidhideStatusDotMain" Width="9" Height="9" Fill="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtHidhideStatusMain" Text="" FontSize="10" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnOpenHidhideClient" Content="{Binding Hidhide_OpenClient}" Click="BtnOpenHidhideClient_Click" Height="26" Padding="10,1" FontSize="9" Foreground="{StaticResource AccentBrush}" Background="#0F2C3A" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Margin="0,0,0,8" HorizontalAlignment="Left"/>

                    <TextBlock Text="{Binding Hidhide_StepHeader}" FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding Hidhide_Step1}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="8,0,0,2"/>
                    <TextBlock Text="{Binding Hidhide_Step2}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="8,0,0,2"/>
                    <TextBlock Text="{Binding Hidhide_Step3}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="8,0,0,2"/>
                    <TextBlock Text="{Binding Hidhide_Note}" FontSize="9" Foreground="#F59E0B" TextWrapping="Wrap" Margin="8,0,0,0"/>

                </StackPanel>

                <ScrollViewer Grid.Row="3" MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                <StackPanel>
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkEditMode" Content="{Binding Edit_ModeEnabled}" Checked="ChkEditMode_Checked" Unchecked="ChkEditMode_Checked" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="White"/>
                    <StackPanel x:Name="PanelEditModes" Visibility="Collapsed" Margin="20,2,0,6">
                        <RadioButton x:Name="RadioEditImage" Content="{Binding Edit_ImageMode}" GroupName="EditModeType" Checked="RadioEditMode_Checked" FontSize="10" Margin="0,0,0,2" Foreground="White"/>
                        <RadioButton x:Name="RadioEditButtons" Content="{Binding Edit_ButtonsMode}" GroupName="EditModeType" Checked="RadioEditMode_Checked" FontSize="10" Margin="0,0,0,4" Foreground="White"/>
                        <Button x:Name="BtnResetPositions" Content="{Binding Edit_ResetPositions}" Click="BtnResetPositions_Click" Height="22" Padding="8,1" Margin="0,0,0,0" Foreground="#EF4444" FontSize="10"/>
                    </StackPanel>
                    <StackPanel x:Name="PanelControllerImageEdit" Visibility="Collapsed" Margin="20,2,0,6">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button x:Name="BtnChangeControllerImage" Content="{Binding Edit_ChangeImage}" Click="BtnChangeControllerImage_Click" Height="22" Padding="8,1" Margin="0,0,6,0" FontSize="10"/>
                            <Button x:Name="BtnResetControllerImage" Content="{Binding Edit_ResetImage}" Click="BtnResetControllerImage_Click" Height="22" Padding="8,1" Foreground="#EF4444" FontSize="10"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Edit_Tip}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="9"/>
                    </StackPanel>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,6,0,4"/>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </ContentControl>
    </Grid>
    </Grid>
</Window>
